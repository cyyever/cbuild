{
  "git_url": "git@github.com:neovim/neovim.git",
  "main_language": "c",
  "build_languages": [
    "python"
  ],
  "environment_variable": [
    "VisualStudioEdition=1",
    "USE_BUNDLED_NVIMQT=off"
  ],
  "dependency": [
    "glog"
  ],
  "system_package_dependency": {
    "ubuntu": [
      "libgtest-dev",
      "libgmock-dev"
    ],
    "archlinux": [
      "lua51",
      "luarocks",
      "msgpack-c",
      "libluv",
      "unibilium",
      "libtermkey",
      "libvterm",
      "lua-lpeg",
      "lua-mpack",
      "gmock"
    ]
  }
}
